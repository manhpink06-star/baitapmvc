@model baitapmvc.Models.DayInfo

@{
    ViewData["Title"] = "Bài 1";

    DateTime today = ViewBag.Today;
}

<div class="container mt-4">

    <h2>Bài 1 - Kiểm tra cuối tuần</h2>

    <hr />

    @if (Model != null)
    {
        <p>
            <strong>Ngày hiện tại:</strong>
            @today.ToString("dd/MM/yyyy")
        </p>

        <p>
            <strong>Hôm nay là:</strong>
            @Model.DayName
        </p>

        @if (Model.IsWeekend)
        {
            <div class="alert alert-success">
                Hôm nay là cuối tuần.
            </div>
        }
        else
        {
            <div class="alert alert-danger">
                Hôm nay không phải là cuối tuần.
            </div>
        }

        <p class="text-muted">
            Kết quả được kiểm tra từ SQL Server.
        </p>
    }
    else
    {
        <div class="alert alert-warning">
            Không tìm thấy dữ liệu ngày trong SQL Server.
        </div>
    }

</div>