@model IEnumerable<baitapmvc.Models.Product>

@{
    ViewData["Title"] = "Bài 2";
}

<div class="container mt-4">

    <h2>Bài 2 - Danh sách sản phẩm</h2>

    <p>Dữ liệu lấy từ SQL Server</p>

    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>

                    <td>@product.Name</td>

                    <td>
                        @product.Price.ToString("N0") VNĐ
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>